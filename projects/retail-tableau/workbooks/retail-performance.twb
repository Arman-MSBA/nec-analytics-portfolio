  <actions>
    <action caption="Region drilldown" name="[Action1_7130E911744E4137981BDD1917B3F7D7]">
      <activation auto-clear="true" type="on-select" />
      <source dashboard="Interactive Insights" type="sheet" worksheet="Interactive Region Sales" />
      <link caption="Region drilldown" delimiter="," escape="\" expression="tsl:Interactive%20Insights?%5Bfederated.module7retail%5D.%5BRegion%5D~s0=&lt;[federated.module7retail].[Region]~na&gt;" include-null="true" multi-select="true" url-escape="true" />
      <command command="tsc:tsl-filter">
        <param name="exclude" value="Interactive Region Sales" />
        <param name="target" value="Interactive Insights" />
      </command>
    </action>
    <action caption="Hover category across charts" name="[Action2_B28CE66D10A841948B471978F1FD0975]">
      <activation auto-clear="true" type="on-hover" />
      <source dashboard="Interactive Insights" type="sheet" worksheet="Interactive Category Profit" />
      <command command="tsc:brush">
        <param name="exclude" value="Monthly Sales vs Target,Interactive Region Sales" />
        <param name="field-captions" value="Category" />
        <param name="target" value="Interactive Insights" />
      </command>
    </action>
    <datasources>
      <datasource caption="Module 7 Daily Retail" name="federated.module7retail" />
    </datasources>
    <datasource-dependencies datasource="federated.module7retail">
      <column caption="Region" datatype="string" name="[Region]" role="dimension" type="nominal" />
    </datasource-dependencies>
    <edit-group-action caption="Select categories for emphasis" name="[Action4_A5364BDA973541EFA90F58D4F157E0D6]">
      <activation type="on-select" />
      <source dashboard="Interactive Insights" type="sheet" worksheet="Interactive Category Profit" />
      <add-or-remove-marks value="assign" />
      <params>
        <param name="selection-clear-set-option" value="exclude-all" />
        <param name="target-group" value="[federated.module7retail].[Category Set]" />
      </params>
    </edit-group-action>
    <edit-parameter-action caption="Region sets monthly target" name="[Action3_0E49384BD349472BBA586B2FDA2C33CE]">
      <activation type="on-select" />
      <source dashboard="Interactive Insights" type="sheet" worksheet="Interactive Region Sales" />
      <agg-type type="sum" />
      <clear-option type="assign-fixed-value" value="r:12:5:7749110.78725" />
      <params>
        <param name="source-field" value="[federated.module7retail].[min:Region Monthly Target:qk]" />
        <param name="target-parameter" value="[Parameters].[Selected Region Target]" />
      </params>
    </edit-parameter-action>
  </actions>
  <worksheets>
    <worksheet name="Category Monthly Sales">
      <table>
        <view>
          <datasources>
            <datasource caption="Module 7 Daily Retail" name="federated.module7retail" />
          </datasources>
          <datasource-dependencies datasource="federated.module7retail">
            <column caption="Category" datatype="string" name="[Category]" role="dimension" type="nominal" />
            <column caption="Date" datatype="date" name="[Date]" role="dimension" type="ordinal" />
            <column caption="Month" datatype="datetime" name="[Month]" role="dimension" type="ordinal">
              <calculation class="tableau" formula="DATETRUNC(&quot;month&quot;,[Date])" />
            </column>
            <column caption="Region" datatype="string" name="[Region]" role="dimension" type="nominal" />
            <column caption="Sales" datatype="real" default-format="c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)" name="[Sales]" role="measure" type="quantitative" />
            <column-instance column="[Category]" derivation="None" name="[none:Category:nk]" pivot="key" type="nominal" />
            <column-instance column="[Month]" derivation="None" name="[none:Month:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Sales]" derivation="Sum" name="[sum:Sales:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <filter class="categorical" column="[federated.module7retail].[Action (Region)]">
            <groupfilter function="level-members" level="[Region]" ns0:ui-action-filter="[Action1_7130E911744E4137981BDD1917B3F7D7]" ns0:ui-enumeration="all" ns0:ui-marker="enumerate" />
          </filter>
          <slices>
            <column>[federated.module7retail].[Action (Region)]</column>
          </slices>

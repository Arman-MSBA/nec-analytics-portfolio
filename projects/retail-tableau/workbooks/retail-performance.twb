      <column-instance column="[Sales Status]" derivation="User" name="[usr:Sales Status:nk]" pivot="key" type="nominal" />
      <group caption="Action (Region)" hidden="true" name="[Action (Region)]" name-style="unqualified" ns0:auto-column="sheet_link">
        <groupfilter function="crossjoin">
          <groupfilter function="level-members" level="[Region]" />

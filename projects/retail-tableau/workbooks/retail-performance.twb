      <aliases enabled="yes" />
      <column caption="Category" datatype="string" name="[Category]" role="dimension" type="nominal" />
      <column caption="Date" datatype="date" name="[Date]" role="dimension" type="ordinal" />
      <column caption="Latest Year" datatype="boolean" name="[Latest Year]" role="dimension" type="nominal">
        <calculation class="tableau" formula="YEAR([Date]) = YEAR({ FIXED : MAX([Date]) })" />
      </column>
      <column caption="Margin Status" datatype="string" name="[Margin Status]" role="measure" type="nominal">
        <calculation class="tableau" formula="IF [YTD Margin] &gt;= 0.15 THEN &quot;Above target&quot; ELSE &quot;Below target&quot; END" />
      </column>
      <column caption="Month" datatype="datetime" name="[Month]" role="dimension" type="ordinal">
        <calculation class="tableau" formula="DATETRUNC(&quot;month&quot;,[Date])" />
      </column>
      <column caption="Order Status" datatype="string" name="[Order Status]" role="measure" type="nominal">
        <calculation class="tableau" formula="IF [YTD Orders] &gt;= [Order Target] THEN &quot;Above target&quot; ELSE &quot;Below target&quot; END" />
      </column>
      <column caption="Order Target" datatype="real" default-format="n#,##0" name="[Order Target]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IF YEAR([Date]) = YEAR({ FIXED : MAX([Date]) }) - 1 THEN [Order Volume] END) * 1.05" />
      </column>
      <column caption="Order Volume" datatype="integer" default-format="n#,##0" name="[Order Volume]" role="measure" type="quantitative" />
      <column caption="Profit Ratio" datatype="real" default-format="p0.0%" name="[Profit Ratio]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([Profit]) / SUM([Sales])" />
      </column>
      <column caption="Profit Status" datatype="string" name="[Profit Status]" role="measure" type="nominal">
        <calculation class="tableau" formula="IF [YTD Profit] &gt;= [Profit Target] THEN &quot;Above target&quot; ELSE &quot;Below target&quot; END" />
      </column>
      <column caption="Profit Target" datatype="real" default-format="c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)" name="[Profit Target]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IF YEAR([Date]) = YEAR({ FIXED : MAX([Date]) }) - 1 THEN [Profit] END) * 1.05" />
      </column>
      <column caption="Profit" datatype="real" default-format="c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)" name="[Profit]" role="measure" type="quantitative" />
      <column caption="Region Monthly Target" datatype="real" default-format="c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)" name="[Region Monthly Target]" role="measure" type="quantitative">
        <calculation class="tableau" formula="{ FIXED [Region] : SUM(IF YEAR([Date]) = 2023 THEN [Sales] END) } / 12 * 1.05" />
      </column>
      <column caption="Region" datatype="string" name="[Region]" role="dimension" type="nominal" />
      <column caption="Sales Status" datatype="string" name="[Sales Status]" role="measure" type="nominal">
        <calculation class="tableau" formula="IF [YTD Sales] &gt;= [Sales Target] THEN &quot;Above target&quot; ELSE &quot;Below target&quot; END" />
      </column>
      <column caption="Sales Target" datatype="real" default-format="c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)" name="[Sales Target]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IF YEAR([Date]) = YEAR({ FIXED : MAX([Date]) }) - 1 THEN [Sales] END) * 1.05" />
      </column>
      <column caption="Sales" datatype="real" default-format="c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)" name="[Sales]" role="measure" type="quantitative" />
      <column caption="Segment" datatype="string" name="[Segment]" role="dimension" type="nominal" />
      <column caption="Selected Region Target" datatype="real" default-format="c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)" name="[Selected Region Target]" role="measure" type="quantitative">
        <calculation class="tableau" formula="[Parameters].[Selected Region Target]" />
      </column>
      <column caption="YTD Margin" datatype="real" default-format="p0.0%" name="[YTD Margin]" role="measure" type="quantitative">
        <calculation class="tableau" formula="[YTD Profit] / [YTD Sales]" />
      </column>
      <column caption="YTD Orders" datatype="integer" default-format="n#,##0" name="[YTD Orders]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IF YEAR([Date]) = YEAR({ FIXED : MAX([Date]) }) THEN [Order Volume] END)" />
      </column>
      <column caption="YTD Profit" datatype="real" default-format="c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)" name="[YTD Profit]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IF YEAR([Date]) = YEAR({ FIXED : MAX([Date]) }) THEN [Profit] END)" />
      </column>
      <column caption="YTD Sales" datatype="real" default-format="c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)" name="[YTD Sales]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IF YEAR([Date]) = YEAR({ FIXED : MAX([Date]) }) THEN [Sales] END)" />
      </column>
      <column caption="Module 7 Daily Retail" datatype="table" name="[__tableau_internal_object_id__].[federated_module7retail_object]" role="measure" type="quantitative" />
      <column-instance column="[Category Set]" derivation="InOut" name="[io:Category Set:nk]" pivot="key" type="nominal" />
      <column-instance column="[Category]" derivation="None" name="[none:Category:nk]" pivot="key" type="nominal" />
      <column-instance column="[Margin Status]" derivation="User" name="[usr:Margin Status:nk]" pivot="key" type="nominal" />
      <column-instance column="[Order Status]" derivation="User" name="[usr:Order Status:nk]" pivot="key" type="nominal" />
